{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.js",
      "tests/**/*.js",
      "scripts/**/*.js",
      "**/*.json",
      "!**/node_modules",
      "!.worktrees",
      "!data",
      "!src/static/htmx.min.js",
      "!src/views",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    },
    "globals": ["process", "Buffer", "__dirname", "__filename", "global"]
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
